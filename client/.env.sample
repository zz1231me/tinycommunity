# 화면(Vite) 설정. 이 파일을 client/.env.local 로 복사해 쓴다.
#
# 포트를 바꿀 때는 손으로 고치지 말고 저장소 루트에서 아래 명령을 쓰는 편이 안전하다.
# 서버 PORT 와 아래 VITE_API_URL 을 함께 맞춰 주기 때문이다 — 한쪽만 바꾸면 화면은
# 뜨는데 로그인부터 실패한다.
#
#   npm run ports -- --web 9000 --api 5000
#
# 이 파일에 적은 값은 git 에 올라가지 않는다(.env.local 은 무시 대상이다).

# 개발 서버가 들을 포트. 비워 두면 8080.
VITE_PORT=8080

# 개발 중 /api 요청을 넘길 곳. 서버의 PORT 와 같아야 한다. 비워 두면 http://127.0.0.1:4000.
VITE_API_URL=http://127.0.0.1:4000
